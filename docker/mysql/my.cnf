# 初期化スクリプト（docker-entrypoint-initdb.d）は mysql クライアント経由で実行される。
# そのクライアントの既定文字セットはコンテナのロケール次第で latin1 になり、
# UTF-8 の SQL ファイルが化けたまま投入される。ここで明示的に揃える。
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
