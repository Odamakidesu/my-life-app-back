{
  "family": "my-life-app-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "mylifeapp",
      "image": "498504718094.dkr.ecr.ap-northeast-1.amazonaws.com/mylifeapp:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/my-life-app-task",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "APP_API_ENDPOINT_BASE_URL",
          "value": "http://my-life-app.s3-website-ap-northeast-1.amazonaws.com"
        },
        {
          "name": "SPRING_SQL_INIT_MODE",
          "value": "never"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:498504718094:parameter/mylifeapp/prod/datasource-url"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:498504718094:parameter/mylifeapp/prod/datasource-username"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:498504718094:parameter/mylifeapp/prod/datasource-password"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:498504718094:parameter/mylifeapp/prod/jwt-secret"
        }
      ]
    }
  ],
  "executionRoleArn": "arn:aws:iam::498504718094:role/ecsTaskExecutionRole"
}
